#!/bin/sh
# Auto-mirrors the compiled Overleaf manuscript PDF (manuscript/main.pdf) up to the repo
# root as manuscript-ADNI.pdf on every commit, so machines without Overleaf git credentials
# get the current PDF from a plain `git pull` on this repo.
#
# Best-effort: tries to fetch the latest from Overleaf first, but never blocks the commit
# if Overleaf is unreachable (matches the existing manuscript/-is-optional design — see
# PLAN.md's "PDF mirroring" note).
#
# Enable with: git config core.hooksPath ops/git-hooks   (one-time, per machine — this
# config itself is not versioned, only the hook script is).

repo_root=$(git rev-parse --show-toplevel)
manuscript_dir="$repo_root/manuscript"
src="$manuscript_dir/main.pdf"
dst="$repo_root/manuscript-ADNI.pdf"

if [ -e "$manuscript_dir/.git" ]; then
    (cd "$manuscript_dir" && git pull --ff-only origin main) >/dev/null 2>&1 || true
fi

if [ -f "$src" ]; then
    if ! cmp -s "$src" "$dst" 2>/dev/null; then
        cp "$src" "$dst"
        git add "$dst"
        echo "pre-commit: refreshed manuscript-ADNI.pdf from manuscript/main.pdf"
    fi
fi

exit 0
